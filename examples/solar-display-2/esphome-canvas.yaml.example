# Editable Home Assistant screen with generic touch coordinates.
# Only an image-scoped credential is sent to Home Assistant. Normal layout
# changes happen in the GeekMagic editor and need no firmware update.
substitutions:
  canvas_ics_view_entity: sensor.general_display_2_ics_control

http_request:
  id: canvas_http
  timeout: 5s
  follow_redirects: false

time:
  - platform: homeassistant
    id: canvas_ha_time
    update_interval: 10s

api:
  on_client_connected:
    - lambda: |-
        if (solar_display::is_home_assistant_client(client_info)) {
          ++id(canvas_ha_connections);
          id(canvas_ics_view_read_pending) = false;
          id(canvas_pressed_control).clear();
          solar_display::canvas_frame().control_view().invalidate();
          id(canvas_ics_view).publish_state("");
          id(show_ics_request_feedback).execute();
        }
  on_client_disconnected:
    - lambda: |-
        if (solar_display::is_home_assistant_client(client_info)) {
          if (id(canvas_ha_connections) != 0) --id(canvas_ha_connections);
          solar_display::canvas_frame().control_view().invalidate();
          id(canvas_pressed_control).clear();
          id(canvas_ics_view_read_pending) = id(canvas_ha_connections) == 1;
          if (id(canvas_ha_connections) == 0) {
            id(check_canvas_freshness).execute();
          } else if (id(canvas_ha_connections) == 1) {
            id(canvas_ics_view).publish_state("");
            id(refresh_canvas_ics_view).execute();
          }
          id(show_ics_request_feedback).execute();
        }

image:
  - platform: online_image
    id: canvas_image
    http_request_id: canvas_http
    url: !secret canvas_image_url
    request_headers:
      Authorization: !secret canvas_authorization
      Cache-Control: no-cache
    format: PNG
    type: RGB565
    transparency: opaque
    resize: 480x480
    buffer_size: 16384
    update_interval: 10s
    on_download_finished:
      - lambda: |-
          // LVGL only sees this completed front frame, never the decoder's
          // working buffer. A 304 validates the fetch without refreshing the render time.
          auto &frame = solar_display::canvas_frame();
          const uint32_t now_ms = millis();
          const auto now = id(canvas_ha_time).now();
          if (!now.is_valid() || !frame.freshness().fresh(now_ms, now.timestamp)) {
            id(canvas_pressed_control).clear();
          }
          if (!cached) {
            const auto &download = *id(canvas_image);
            const auto marker = solar_display::StableCanvasFrame::read_marker(download);
            if (!now.is_valid() || !frame.freshness().accepts(marker.rendered_at, now_ms, now.timestamp)) {
              id(reset_canvas_image).execute();
              return;
            }
            auto result = frame.commit(download);
            if (result == solar_display::StableCanvasFrame::CommitResult::INVALID) {
              ESP_LOGW("canvas_frame", "Completed image could not be committed");
              id(reset_canvas_image).execute();
              return;
            }
            if (result == solar_display::StableCanvasFrame::CommitResult::CHANGED) {
              // Invalidate cached pixels and the initial1x1 header together.
              lv_image_cache_drop(frame.get_lv_image_dsc());
              if (frame.commit_count() == 1) {
                esphome::lvgl::lv_image_set_src(id(canvas_image_widget), &frame);
              } else {
                // Keep the image source attached and repaint only changed
                // pixel bands instead of flushing the entire480x480 panel.
                for (const auto &region : frame.dirty_regions()) {
                  if (!region.valid()) continue;
                  lv_area_t area = {region.x1, region.y1, region.x2, region.y2};
                  lv_obj_invalidate_area(id(canvas_image_widget), &area);
                }
              }
            }
            frame.freshness().publish_render(marker.rendered_at, now_ms, now.timestamp);
            if (marker.control != id(canvas_frame_control)) {
              // Flush the updated buttons before allowing a touch to use their new target.
              lv_refr_now(lv_obj_get_display(id(canvas_image_widget)));
              id(canvas_frame_control) = marker.control;
              id(canvas_frame_control_changed_ms) = millis();
              id(canvas_pressed_control).clear();
            }
          } else if (!frame.ready()) {
            id(reset_canvas_image).execute();
            return;
          }
          frame.freshness().note_fetch(now_ms);
          id(canvas_image_ready) = true;
          id(show_canvas_dashboard).execute();
          id(check_canvas_freshness).execute();
          id(show_ics_request_feedback).execute();
    on_error:
      # The front frame survives a failed download; retry in the back buffer.
      # The fetch and render deadlines still control the offline screen.
      - script.execute: reset_canvas_image

globals:
  - id: canvas_ha_connections
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_ics_view_read_pending
    type: bool
    restore_value: false
    initial_value: "false"
  - id: canvas_image_ready
    type: bool
    restore_value: false
    initial_value: "false"
  - id: canvas_showing
    type: bool
    restore_value: false
    initial_value: "false"

  - id: canvas_frame_control
    type: std::string
    restore_value: false
    initial_value: '""'
  - id: canvas_pressed_control
    type: std::string
    restore_value: false
    initial_value: '""'
  - id: canvas_pressed_button
    type: int
    restore_value: false
    initial_value: "0"
  - id: canvas_frame_control_changed_ms
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_last_touch_ms
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_touch_event_count
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_touch_x
    type: int
    restore_value: false
    initial_value: "-1"
  - id: canvas_touch_y
    type: int
    restore_value: false
    initial_value: "-1"
  - id: canvas_touch_age_seconds
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_touch_rendered_at_epoch
    type: uint32_t
    restore_value: false
    initial_value: "0"
  - id: canvas_touch_control
    type: std::string
    restore_value: false
    initial_value: '""'

text_sensor:
  - platform: homeassistant
    id: canvas_ics_view
    entity_id: ${canvas_ics_view_entity}
    internal: true
    on_value:
      - lambda: |-
          if (id(canvas_ha_connections) == 1 && !id(canvas_ics_view_read_pending)) {
            solar_display::canvas_frame().control_view().observe(x);
          }
      - script.execute: show_ics_request_feedback
  - platform: template
    id: canvas_screen_source
    name: Screen source
    entity_category: diagnostic
    lambda: |-
      return id(canvas_showing) ? "Home Assistant" : "Offline";
    update_interval: 5s

script:
  - id: refresh_canvas_ics_view
    mode: restart
    then:
      - lambda: |-
          auto &pending = id(canvas_ics_view_read_pending);
          auto &view = solar_display::canvas_frame().control_view();
          const uint32_t now = millis();
          const bool retry = view.needs_recheck(now);
          auto *server = api::global_api_server;
          if ((!pending && !retry) || id(canvas_ha_connections) != 1 ||
              !server->is_connected_with_state_subscription()) return;

          // An old socket can deliver queued state after the replacement's initial state.
          // Read the surviving client's current view before enabling the displayed control.
          for (const auto &client : server->active_clients()) {
            if (!client->is_authenticated() || client->is_marked_for_removal() ||
                !solar_display::is_home_assistant_client(client->get_name())) continue;

            api::SubscribeHomeAssistantStateResponse read;
            read.entity_id = StringRef("${canvas_ics_view_entity}");
            read.once = true;
            if (client->send_message(read)) {
              pending = false;
              if (retry) view.recheck_sent(now);
            }
            return;
          }
  - id: show_ics_request_feedback
    mode: restart
    then:
      - lambda: |-
          // Show control availability and request feedback between image downloads.
          using solar_display::ChargerFeedback;
          const auto &view = solar_display::canvas_frame().control_view();
          const auto &state = view.state();
          const auto &displayed = id(canvas_frame_control);
          const bool showing = id(canvas_showing);
          const bool unavailable = showing &&
              (id(canvas_ha_connections) != 1 || state.feedback == ChargerFeedback::UNKNOWN ||
               state.feedback == ChargerFeedback::UNAVAILABLE);
          const bool starting = showing && !unavailable && state.feedback == ChargerFeedback::STARTING;
          const bool stopping = showing && !unavailable && state.feedback == ChargerFeedback::STOPPING;
          const bool pending = starting || stopping;
          const bool no_control = state.control.empty() && displayed.empty();
          const bool blocked = unavailable || pending || (!no_control && !view.allows(state.button, displayed));
          if (!showing || blocked) {
            id(canvas_pressed_control).clear();
          }
          const char *feedback = nullptr;
          if (unavailable) {
            feedback = "Charger buttons unavailable";
          } else if (pending) {
            feedback = "Waiting for charger confirmation";
          } else if (showing && state.feedback == ChargerFeedback::STARTING_TIMEOUT) {
            feedback = "Start not confirmed";
          } else if (showing && state.feedback == ChargerFeedback::STOPPING_TIMEOUT) {
            feedback = "Stop not confirmed";
          } else if (showing && blocked) {
            feedback = "Charger buttons unavailable";
          }
          auto *hint = id(canvas_ics_request_hint);
          auto *hint_label = id(canvas_ics_request_hint_label);
          if (hint != nullptr && hint_label != nullptr) {
            if (feedback == nullptr) {
              lv_obj_add_flag(hint, LV_OBJ_FLAG_HIDDEN);
            } else {
              lv_label_set_text(hint_label, feedback);
              lv_obj_set_style_text_color(hint_label, lv_color_hex(pending ? 0x91A8C1 : 0xFFC477), 0);
              lv_obj_clear_flag(hint, LV_OBJ_FLAG_HIDDEN);
            }
          }
          auto *start_button = id(canvas_ics_start_feedback);
          auto *stop_button = id(canvas_ics_stop_feedback);
          if (start_button == nullptr || stop_button == nullptr) return;
          if (!showing || !blocked) {
            lv_obj_add_flag(start_button, LV_OBJ_FLAG_HIDDEN);
            lv_obj_add_flag(stop_button, LV_OBJ_FLAG_HIDDEN);
            return;
          }
          auto format = [](lv_obj_t *button, lv_obj_t *label, bool pending,
                           const char *pending_text, const char *idle_text) {
            lv_obj_set_style_bg_color(button, lv_color_hex(pending ? 0x805523 : 0x1C2B33), 0);
            lv_obj_set_style_border_color(button, lv_color_hex(pending ? 0xFFC477 : 0x30414C), 0);
            lv_obj_set_style_text_color(label, lv_color_hex(pending ? 0xFFF3DD : 0x718490), 0);
            lv_label_set_text(label, pending ? pending_text : idle_text);
            lv_obj_clear_flag(button, LV_OBJ_FLAG_HIDDEN);
          };
          format(start_button, id(canvas_ics_start_feedback_label), starting, "STARTING...", "START ICS");
          format(stop_button, id(canvas_ics_stop_feedback_label), stopping, "STOPPING...", "STOP ICS");
  - id: reset_canvas_image
    mode: restart
    then:
      - online_image.release: canvas_image
      - lambda: id(canvas_image_ready) = solar_display::canvas_frame().ready();
      - script.execute: check_canvas_freshness
  - id: show_canvas_dashboard
    mode: restart
    then:
      - if:
          condition:
            lambda: |-
              const auto now = id(canvas_ha_time).now();
              return id(canvas_ha_connections) != 0 &&
                  api::global_api_server->is_connected_with_state_subscription() &&
                  id(canvas_image_ready) &&
                  now.is_valid() &&
                  solar_display::canvas_frame().freshness().fresh(millis(), now.timestamp);
          then:
            - if:
                condition:
                  not:
                    lvgl.page.is_showing: canvas_dashboard
                then:
                  - lvgl.page.show: canvas_dashboard
            - globals.set:
                id: canvas_showing
                value: "true"
            - text_sensor.template.publish:
                id: canvas_screen_source
                state: Home Assistant
  - id: check_canvas_freshness
    mode: restart
    then:
      - if:
          condition:
            lambda: |-
              const auto now = id(canvas_ha_time).now();
              return id(canvas_showing) &&
                  (id(canvas_ha_connections) == 0 ||
                   !api::global_api_server->is_connected_with_state_subscription() ||
                   !id(canvas_image_ready) || !now.is_valid() ||
                   !solar_display::canvas_frame().freshness().fresh(millis(), now.timestamp));
          then:
            - globals.set:
                id: canvas_showing
                value: "false"
            - lvgl.page.show: offline_dashboard
            - script.execute: show_ics_request_feedback
            - text_sensor.template.publish:
                id: canvas_screen_source
                state: Offline
            - script.execute: update_dashboard

interval:
  - interval: 1s
    then:
      - script.execute: check_canvas_freshness
      - script.execute: refresh_canvas_ics_view

lvgl:
  pages:
    - id: canvas_dashboard
      bg_color: 0x0B1020
      pad_all: 0
      scrollbar_mode: "OFF"
      widgets:
        - image:
            id: canvas_image_widget
            x: 0
            y: 0
            width: 480
            height: 480
            # Starts with a valid1x1placeholder. Completed frames are copied
            # into this independent image only after a successful decode.
            src: !lambda return &solar_display::canvas_frame();
        - obj:
            x: 0
            y: 474
            width: 480
            height: 6
            bg_color: 0x0B1119
            border_width: 0
            radius: 0
            clickable: false
        - obj:
            id: canvas_ics_start_feedback
            x: 20
            y: 366
            width: 212
            height: 62
            pad_all: 0
            radius: 16
            border_width: 2
            scrollbar_mode: "OFF"
            hidden: true
            widgets:
              - label:
                  id: canvas_ics_start_feedback_label
                  align: CENTER
                  text_font: montserrat_22
                  text: START ICS
        - obj:
            id: canvas_ics_stop_feedback
            x: 248
            y: 366
            width: 212
            height: 62
            pad_all: 0
            radius: 16
            border_width: 2
            scrollbar_mode: "OFF"
            hidden: true
            widgets:
              - label:
                  id: canvas_ics_stop_feedback_label
                  align: CENTER
                  text_font: montserrat_22
                  text: STOP ICS
        - obj:
            id: canvas_ics_request_hint
            x: 20
            y: 432
            width: 440
            height: 24
            bg_color: 0x0B1119
            bg_opa: COVER
            border_width: 0
            radius: 0
            pad_all: 0
            clickable: false
            scrollbar_mode: "OFF"
            hidden: true
            widgets:
              - label:
                  id: canvas_ics_request_hint_label
                  align: CENTER
                  text_font: montserrat_14
        # LVGL gives post-rotation visible pixels. The full-screen hit surface
        # lets HA route future controls without further firmware changes.
        - button:
            id: canvas_touch_button
            x: 0
            y: 0
            width: 480
            height: 442
            bg_opa: TRANSP
            border_width: 0
            shadow_width: 0
            radius: 0
            pad_all: 0
            pressed:
              bg_opa: TRANSP
            on_press:
              - lambda: |-
                  const auto press_point = esphome::lvgl::LvglComponent::get_touch_relative_to_obj(
                      id(canvas_touch_button));
                  const auto button = solar_display::charger_button_at(press_point.x, press_point.y);
                  id(canvas_pressed_button) = static_cast<int>(button);
                  id(canvas_pressed_control).clear();
                  const auto clock = id(canvas_ha_time).now();
                  const uint32_t now = millis();
                  auto &frame = solar_display::canvas_frame();
                  auto &freshness = frame.freshness();
                  if (id(canvas_ha_connections) == 1 && frame.control_view().allows(button, id(canvas_frame_control)) &&
                      id(canvas_showing) && id(canvas_image_ready) && clock.is_valid() &&
                      api::global_api_server->is_connected_with_state_subscription() &&
                      freshness.fresh(now, clock.timestamp) &&
                      uint32_t(now - id(canvas_frame_control_changed_ms)) >= 100) {
                    id(canvas_pressed_control) = id(canvas_frame_control);
                    // A refresh with the same target must preserve the age and epoch of the pressed image.
                    frame.pressed_freshness() = freshness;
                  }
            on_click:
              - if:
                  condition:
                    lambda: |-
                      const auto point = esphome::lvgl::LvglComponent::get_touch_relative_to_obj(
                          id(canvas_touch_button));
                      const uint32_t now = millis();
                      const auto clock = id(canvas_ha_time).now();
                      auto &frame = solar_display::canvas_frame();
                      using solar_display::ChargerButton;
                      const auto button = solar_display::charger_button_at(point.x, point.y);
                      const bool charger_button = button != ChargerButton::NONE;
                      if (charger_button &&
                          (id(canvas_ha_connections) != 1 ||
                           static_cast<int>(button) != id(canvas_pressed_button) ||
                           id(canvas_pressed_control) != id(canvas_frame_control) ||
                           !frame.control_view().allows(button, id(canvas_pressed_control)))) {
                        return false;
                      }
                      if (point.x < 0 || point.x >= 480 || point.y < 0 || point.y >= 442 ||
                          !id(canvas_showing) || !id(canvas_image_ready) ||
                          !frame.ready() || !clock.is_valid() ||
                          !frame.freshness().fresh(now, clock.timestamp) ||
                          id(canvas_ha_connections) == 0 ||
                          !api::global_api_server->is_connected_with_state_subscription() ||
                          (id(canvas_touch_event_count) != 0 &&
                           uint32_t(now - id(canvas_last_touch_ms)) < 500)) return false;
                      auto &touch_frame = charger_button ? frame.pressed_freshness() : frame.freshness();
                      const uint32_t touch_age = touch_frame.render_age_ms(now, clock.timestamp);
                      if (touch_age >= solar_display::CanvasFreshness::MAX_AGE_MS) return false;
                      id(canvas_last_touch_ms) = now;
                      id(canvas_touch_x) = point.x;
                      id(canvas_touch_y) = point.y;
                      id(canvas_touch_age_seconds) = touch_age / 1000;
                      id(canvas_touch_rendered_at_epoch) = touch_frame.rendered_at();
                      id(canvas_touch_control) = charger_button ? id(canvas_pressed_control) : "";
                      ++id(canvas_touch_event_count);
                      if (charger_button) frame.control_view().submitted(id(canvas_touch_control), now);
                      return true;
                  then:
                    - homeassistant.event:
                        event: esphome.general_display_touch
                        data:
                          display: general_display_2
                          x: !lambda return to_string(id(canvas_touch_x));
                          y: !lambda return to_string(id(canvas_touch_y));
                          canvas_age_seconds: !lambda return to_string(id(canvas_touch_age_seconds));
                          canvas_rendered_at_epoch: !lambda return to_string(id(canvas_touch_rendered_at_epoch));
                          frame_control: !lambda return id(canvas_touch_control);
                    - script.execute: show_ics_request_feedback
        - button:
            id: canvas_brightness_button
            x: 0
            y: 442
            width: 480
            height: 38
            bg_opa: TRANSP
            border_width: 0
            shadow_width: 0
            radius: 0
            pad_all: 0
            pressed:
              bg_opa: TRANSP
            on_click:
              - script.execute: toggle_display_brightness
